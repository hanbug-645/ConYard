# --- Option A: Google AI API key (recommended, no GCP project needed) ---
GOOGLE_API_KEY=your-api-key-here

# --- Option B: Vertex AI (uses Google Application Default Credentials) ---
# Comment out GOOGLE_API_KEY above and fill these in instead:
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1

# --- OpenAI (not used yet) ---
# OPENAI_API_KEY=your-openai-key-here

# --- Optional: override the model ---
# LLM_MODEL_ID=gemini-3.8-flash
