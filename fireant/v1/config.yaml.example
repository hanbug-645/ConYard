# FireAnt Agent Framework Configuration
# Copy this file to config.yaml and fill in your API key

gemini:
  api_key: "YOUR_GEMINI_API_KEY"  # Get from https://aistudio.google.com/app/apikey
  model: "gemini-2.0-flash"
  default_temperature: 0.7
  max_output_tokens: 8192
  top_p: 0.95

agents:
  architect:
    temperature: 0.4
    system_prompt: "You are a software architect. Your job is to decompose a high-level PRD into modular sub-components by creating a directory structure."

  strategist:
    temperature: 0.5
    system_prompt: "You are a technical strategist. Your job is to assess risk, manage escalation, and decide when to launch parallel competing approaches."

  pm:
    temperature: 0.6
    system_prompt: "You are a product manager. Your job is to expand skeletal PRDs into detailed, scoped requirements and manage change requests."

  engineer:
    temperature: 0.7
    system_prompt: "You are a software engineer. Your job is to implement source code that satisfies the local PRD requirements."

  reviewer:
    temperature: 0.3
    system_prompt: "You are a code reviewer and QA engineer. Your job is to verify code against the PRD, run tests, and report pass/fail with detailed feedback."

  voter:
    temperature: 0.3
    system_prompt: "You are a technical evaluator. Your job is to compare competing implementations and select the best one based on correctness, quality, performance, and simplicity."

parallel:
  default_candidates: 3
  max_candidates: 5
  temperature_spread: [0.3, 0.7, 1.0]

escalation:
  max_retries: 3
  fail_threshold: 3

manifest:
  status_values: ["pending", "in_progress", "pass", "fail", "blocked"]
  parallel_mode_key: "parallel"

logging:
  level: "INFO"
  file: "fireant.log"
